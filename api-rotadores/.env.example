# Datos de conexion a la base de datos corporativa (Azure Database for
# PostgreSQL). Copiar este archivo a ".env" y llenar los valores reales —
# el ".env" real NUNCA se sube a git. Estos valores los entrega Tecnologia
# a traves de su mecanismo seguro de secretos (ver informe tecnico), no
# deben quedar escritos aqui ni en ningun otro archivo del repositorio.
# NUNCA usar aqui la cuenta/credencial personal de DBeaver — la API debe
# autenticarse con la identidad tecnica exclusiva que cree Tecnologia.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=

# Esquema corporativo donde deben vivir las tablas. La conexion NO trae este
# esquema en su search_path por defecto, asi que la API lo usa para
# calificar cada consulta explicitamente (ej. "progreso.conteos").
PGSCHEMA=progreso

# Puerto en el que corre esta API.
PORT=3002

# Origenes permitidos para llamar esta API, separados por coma. "*" = cualquiera.
CORS_ORIGIN=*
