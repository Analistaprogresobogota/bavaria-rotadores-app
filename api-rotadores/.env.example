# Datos de conexion a la base de datos de Tecnologia (Azure Database for
# PostgreSQL). Copiar este archivo a ".env" y llenar los valores reales —
# el ".env" real NUNCA se sube a git. Son los mismos datos que usan en
# DBeaver para conectarse.
PGHOST=svr-dba-ienm.postgres.database.azure.com
PGPORT=5432
PGDATABASE=dbgroot
PGUSER=userprog
PGPASSWORD=

# Puerto en el que corre esta API.
PORT=3002

# Origenes permitidos para llamar esta API, separados por coma. "*" = cualquiera.
CORS_ORIGIN=*
