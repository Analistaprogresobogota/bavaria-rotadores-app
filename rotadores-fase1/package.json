{
  "name": "rotadores-fase1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:standalone": "vite build && node scripts/build-standalone.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop:dev": "npm run build:standalone && electron .",
    "desktop:build:mac": "npm run build:standalone && electron-builder --mac",
    "desktop:build:win": "npm run build:standalone && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.1",
    "@azure/msal-react": "^5.5.3",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@supabase/supabase-js": "^2.110.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.fase1.rotadores.desktop",
    "productName": "Rotadores Fase 1",
    "files": ["electron/**/*", "dist/**/*"],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": ["portable"]
    }
  }
}
