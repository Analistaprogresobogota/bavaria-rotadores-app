# Copia este archivo a ".env" y completa los valores reales de Entra ID / SharePoint.
# Ver README.md, seccion "Configuracion", para saber de donde sacar cada uno.
# Mientras estos valores sean los de ejemplo, la app solo permite entrar en modo demo.

VITE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_SITE_ID=contoso.sharepoint.com,00000000-0000-0000-0000-000000000000,00000000-0000-0000-0000-000000000000
VITE_LIST_SKUS_ID=00000000-0000-0000-0000-000000000000
VITE_LIST_MODULOS_ID=00000000-0000-0000-0000-000000000000
VITE_LIST_CONTEOS_ID=00000000-0000-0000-0000-000000000000
VITE_LIST_HISTORIAL_ID=00000000-0000-0000-0000-000000000000
VITE_LIST_ROTADORES_ID=00000000-0000-0000-0000-000000000000

# Supabase (opcional, gratis): si se llenan estos dos, el modo demo guarda y
# lee de Supabase en vez de memoria. Ver README, seccion "Base de datos en
# linea (Supabase)", para el paso a paso completo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL publica de api-rotadores (ver /api-rotadores en la raiz del proyecto),
# la API propia que reemplaza a Supabase hablando con la base de datos de
# Tecnologia. Si esta llena, tiene prioridad sobre Supabase. Dejarla vacia
# mientras Tecnologia no la tenga desplegada.
VITE_API_URL=
